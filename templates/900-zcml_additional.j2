<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:db="http://namespaces.zope.org/db">

    <include
        package="z3c.saconfig"
        file="meta.zcml"
        />

    <db:engine
        name="session"
        url="{{ saconfig_uri | e }}"
        echo="{{ sqlalchemy_echo | string | lower }}"
        />
    <db:session engine="session" />

</configure>
